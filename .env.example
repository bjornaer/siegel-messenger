# Copy to .env on the host. Generate secrets with: openssl rand -base64 32
# Local dev: COMPOSE_PROFILES=localbao. Single-server deploy: COMPOSE_PROFILES=bao (docs/deploy.md).
COMPOSE_PROFILES=localbao
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SIEGEL_BAO_ADDR=
SIEGEL_BAO_TOKEN=
SIEGEL_GATEWAYAPI_TOKEN=
# Keep low until device attestation (ID-02) ships: it is the main SMS-pumping brake.
SIEGEL_SMS_DAILY_CAP=50
SIEGEL_DENY_PREFIXES=
SIEGEL_DOMAIN=
SIEGEL_HTTP_PORT=58080
SIEGEL_HTTPS_PORT=58443
BACKUP_DIR=./backups
BACKUP_INTERVAL=86400
