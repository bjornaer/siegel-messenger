# Copy to .env on the host. Generate 32-byte secrets with: openssl rand -base64 32
# SIEGEL_PHONE_PEPPER and SIEGEL_AS_SEED must stay stable: changing the pepper orphans every account.
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SIEGEL_PHONE_PEPPER=
SIEGEL_AS_SEED=
SIEGEL_PORT=58080
BACKUP_DIR=./backups
BACKUP_INTERVAL=86400
