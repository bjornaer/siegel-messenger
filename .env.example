# Copy to .env on the host. Generate secrets with: openssl rand -base64 32
# Local dev: COMPOSE_PROFILES=localbao. Single-server deploy: COMPOSE_PROFILES=bao (docs/deploy.md).
COMPOSE_PROFILES=localbao
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SIEGEL_BAO_ADDR=
SIEGEL_BAO_TOKEN=
SIEGEL_GATEWAYAPI_TOKEN=
# seven.io, used when GatewayAPI fails (or first, if listed first). Leave empty to skip it.
SIEGEL_SEVEN_API_KEY=
# Order to try SMS providers in; only those with a key are used.
SIEGEL_SMS_PROVIDERS=gatewayapi,seven
# Keep low until device attestation (ID-02) ships: it is the main SMS-pumping brake.
SIEGEL_SMS_DAILY_CAP=50
SIEGEL_DENY_PREFIXES=
# Operator alerts (OTP completion < 50%, ID-04): plain-text POST, e.g. https://ntfy.sh/<long-random-topic>
SIEGEL_ALERT_WEBHOOK=
# Push (SRV-05): Firebase service account JSON, base64 on one line (docs/deploy.md section 7).
SIEGEL_FCM_CREDENTIALS=
# App store review account (docs/deploy.md section 6): this number gets this 6-digit code, no SMS.
SIEGEL_REVIEW_PHONE=
SIEGEL_REVIEW_CODE=
SIEGEL_DOMAIN=
# Shown on /privacy and /delete-account (CMP-07).
SIEGEL_CONTACT_EMAIL=
# Update prompt: newest Android build in the Play Store, and the oldest still allowed (0 = none).
SIEGEL_ANDROID_LATEST_BUILD=0
SIEGEL_ANDROID_MIN_BUILD=0
SIEGEL_OPERATOR=
# Production: journald, so server logs expire after 7 days (SEC-03). Local: leave unset.
LOG_DRIVER=
SIEGEL_HTTP_PORT=58080
SIEGEL_HTTPS_PORT=58443
BACKUP_DIR=./backups
BACKUP_INTERVAL=86400
